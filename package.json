{
  "name": "open-shopping-agent",
  "version": "0.2.4",
  "mcpName": "io.browsa/open-shopping-agent",
  "description": "Open-source AI shopping agent: compares Amazon, Walmart, eBay, Best Buy, Target and the Shopify stores you name, fills the carts, and never buys without your OK. Runs on your own Chrome; cloud browsers optional.",
  "license": "MIT",
  "author": "Browsa <support@browsa.io>",
  "homepage": "https://github.com/browsa-io/open-shopping-agent",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/browsa-io/open-shopping-agent.git"
  },
  "bugs": {
    "url": "https://github.com/browsa-io/open-shopping-agent/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "open-shopping-agent": "dist/cli/index.js",
    "osa": "dist/cli/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "web",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p bench/tsconfig.json",
    "test": "node --import tsx --test $(find test -name '*.test.ts' -not -name '*.browser.test.ts' -not -path '*/fixtures/*' | sort)",
    "test:browser": "node --import tsx --test --test-concurrency=1 --test-force-exit test/browser/*.browser.test.ts",
    "test:all": "npm test && npm run test:browser",
    "dev:web": "tsx src/web/server.ts",
    "bench": "tsx bench/run.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "browsa": "^0.3.1",
    "playwright-core": "^1.65.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  },
  "keywords": [
    "ai-shopping",
    "shopping-agent",
    "agentic-commerce",
    "ai-agent",
    "ai-agents",
    "browser-agent",
    "shopping",
    "ecommerce",
    "price-comparison",
    "price-tracker",
    "browser-automation",
    "cdp",
    "playwright",
    "mcp",
    "mcp-server",
    "claude",
    "llm",
    "amazon",
    "walmart",
    "ebay",
    "bestbuy",
    "target",
    "shopify",
    "phantom",
    "browsa"
  ]
}
